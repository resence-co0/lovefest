{
  "name": "lovefeast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/seed.js",
    "db:reset-demo": "node scripts/reset-demo.js",
    "build": "node --check server.js && node --check public/app.js && node --check lib/security.js && node --check lib/draw.js",
    "test": "node --test",
    "test:integration": "node scripts/smoke-production.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/functions": "3.10.1",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
